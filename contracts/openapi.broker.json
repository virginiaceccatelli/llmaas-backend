{
  "components": {
    "schemas": {
      "Conversation": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/Message"
            },
            "title": "Messages",
            "type": "array"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "updated_at",
          "messages"
        ],
        "title": "Conversation",
        "type": "object"
      },
      "ConversationBody": {
        "properties": {
          "messages": {
            "items": {
              "$ref": "#/components/schemas/Message"
            },
            "maxItems": 400,
            "title": "Messages",
            "type": "array"
          },
          "title": {
            "default": "New chat",
            "maxLength": 200,
            "title": "Title",
            "type": "string"
          }
        },
        "title": "ConversationBody",
        "type": "object"
      },
      "ConversationSummary": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "message_count": {
            "title": "Message Count",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "updated_at",
          "message_count"
        ],
        "title": "ConversationSummary",
        "type": "object"
      },
      "CreateKeyRequest": {
        "properties": {
          "expires_in_s": {
            "anyOf": [
              {
                "maximum": 31536000.0,
                "minimum": 60.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires In S"
          },
          "label": {
            "default": "default",
            "maxLength": 64,
            "title": "Label",
            "type": "string"
          }
        },
        "title": "CreateKeyRequest",
        "type": "object"
      },
      "CreatedKey": {
        "properties": {
          "api_key": {
            "title": "Api Key",
            "type": "string"
          },
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "prefix": {
            "title": "Prefix",
            "type": "string"
          },
          "warning": {
            "title": "Warning",
            "type": "string"
          }
        },
        "required": [
          "id",
          "label",
          "api_key",
          "prefix",
          "created_at",
          "expires_at",
          "warning"
        ],
        "title": "CreatedKey",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "KeyInfo": {
        "properties": {
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "prefix": {
            "title": "Prefix",
            "type": "string"
          },
          "revoked": {
            "title": "Revoked",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "label",
          "prefix",
          "created_at",
          "revoked",
          "expires_at"
        ],
        "title": "KeyInfo",
        "type": "object"
      },
      "Message": {
        "properties": {
          "content": {
            "maxLength": 100000,
            "title": "Content",
            "type": "string"
          },
          "role": {
            "pattern": "^(system|user|assistant)$",
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "role",
          "content"
        ],
        "title": "Message",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
