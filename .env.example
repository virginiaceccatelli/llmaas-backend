# Copy to .env and fill in.  .env is gitignored — never commit real secrets.
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)

# ---------------------------------------------------------------------------
# THIRD-PARTY ACCOUNT REQUIRED: Hugging Face  (https://huggingface.co)
# ---------------------------------------------------------------------------
# Free account -> Settings -> Access Tokens -> New token, with the
# "Make calls to Inference Providers" permission.
# Used in dev as the upstream instead of a GPU. In production it is only
# needed on the GPU VM, and only for gated model repos.
HF_TOKEN=hf_replace_me

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_USER=llmaas
POSTGRES_PASSWORD=change_me_before_production
POSTGRES_DB=llmaas

# ---------------------------------------------------------------------------
# Broker behaviour
# ---------------------------------------------------------------------------
# Prefix on every issued API key. Register it with your secret scanner.
KEY_PREFIX=wiit
RATE_LIMIT_PER_MIN=60
UPSTREAM_TIMEOUT_S=120

# !!! DEV ONLY !!!
# While true, /keys and /usage are unauthenticated and trust an X-Dev-User
# header. Set to false and implement require_user() in broker/app/security.py
# before this service is reachable by anything but you. See docs/AUTH.md.
DEV_AUTH_ENABLED=true
DEV_USER_ID=demo-user

# ---------------------------------------------------------------------------
# Production only — used by serving/models.prod.yaml and the GPU VM
# ---------------------------------------------------------------------------
# Private IP of the GPU serving VM.
VLLM_QWEN_HOST=10.0.0.21
# Shared secret between broker and vLLM (`vllm --api-key`). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
VLLM_API_KEY=change_me
# Private IP the vLLM container binds to on the GPU VM.
PRIVATE_IP=10.0.0.21
