# Copy to .env and fill in.  .env is gitignored — never commit real secrets.
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)

# ---------------------------------------------------------------------------
# THIRD-PARTY ACCOUNT REQUIRED: Hugging Face  (https://huggingface.co)
# ---------------------------------------------------------------------------
# Free account -> Settings -> Access Tokens -> New token, with the
# "Make calls to Inference Providers" permission.
# Used in dev as the upstream instead of a GPU. In production it is only
# needed on the GPU VM, and only for gated model repos.
HF_TOKEN=hf_replace_me

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_USER=llmaas
POSTGRES_PASSWORD=change_me_before_production
POSTGRES_DB=llmaas

# ---------------------------------------------------------------------------
# Broker behaviour
# ---------------------------------------------------------------------------
# Prefix on every issued API key. Register it with your secret scanner.
KEY_PREFIX=wiit
RATE_LIMIT_PER_MIN=60
UPSTREAM_TIMEOUT_S=120

# "redis" in Docker and in production. Set to "memory" ONLY when running the
# broker directly on your laptop without a Redis server — counters then live
# in the process, so they are per-worker and reset on restart.
RATE_LIMIT_BACKEND=redis

# ---------------------------------------------------------------------------
# Running the broker DIRECTLY on your machine (no Docker)
# ---------------------------------------------------------------------------
# Uncomment these two, and set RATE_LIMIT_BACKEND=memory above if you have no
# local Redis. The container defaults point at the Docker service hostnames
# ("postgres", "redis"), which only resolve inside the compose network.
#
# docker-compose.yml sets all three of these explicitly for the container, so
# leaving them uncommented does not affect `docker compose up`.
#
# DATABASE_URL=postgresql://llmaas:llmaas@127.0.0.1:5432/llmaas
# MODELS_FILE=./serving/models.dev.yaml

# ---------------------------------------------------------------------------
# Control-plane authentication — who may create/revoke API keys.
# Full explanation in docs/AUTH.md.
# ---------------------------------------------------------------------------
# "dev"   - LOCAL ONLY. Trusts an unverified X-Dev-User header.
# "hs256" - Verify a JWT signed by the frontend BFF with a shared secret.
# "oidc"  - Verify a JWT from an identity provider against its JWKS.
AUTH_MODE=dev
DEV_USER_ID=demo-user

# For AUTH_MODE=hs256. Must match the secret the frontend BFF signs with.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# AUTH_JWT_SECRET=

# For AUTH_MODE=oidc, e.g. https://auth.example.org/.well-known/jwks.json
# AUTH_OIDC_JWKS_URL=

# Checked in both JWT modes. Leave empty to skip the check; SET BOTH IN PROD,
# otherwise a token minted for another service is accepted here.
# AUTH_JWT_ISSUER=llmaas-frontend
# AUTH_JWT_AUDIENCE=llmaas-broker

# ---------------------------------------------------------------------------
# Production only — used by serving/models.prod.yaml and the GPU VM
# ---------------------------------------------------------------------------
# Private IP of the GPU serving VM.
VLLM_QWEN_HOST=10.0.0.21
# Shared secret between broker and vLLM (`vllm --api-key`). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
VLLM_API_KEY=change_me
# Private IP the vLLM container binds to on the GPU VM.
PRIVATE_IP=10.0.0.21
